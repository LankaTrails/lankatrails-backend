# Copy to .env (git-ignored). Loaded by Spring Boot via spring-dotenv and by
# docker-compose.dev.yml. Values below match the local docker-compose services.

# --- PostgreSQL + PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lankatrails
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- MongoDB (chat history) ---
MONGODB_PORT=27017
MONGODB_URI=mongodb://localhost:27017/lankatrails

# --- Redis (refresh tokens, cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=lankatrails
REDIS_SSL_ENABLED=false

# --- RabbitMQ (AMQP + STOMP broker relay) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_STOMP_PORT=61613
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_USERNAME=lankatrails
RABBITMQ_PASSWORD=lankatrails

# --- Security ---
# Base64-encoded key of at least 256 bits, e.g. `openssl rand -base64 64`
JWT_SECRET=
# Access token lifetime (1 hour) and refresh token lifetime (7 days), in milliseconds
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
# Public base URL of this API, used in email verification links
APP_PUBLIC_API_URL=http://localhost:8080
# Initial admin account, created on first start if no admin exists. Use a strong password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Comma-separated browser origins for REST CORS and the /ws endpoint
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:19006

# --- File uploads ---
UPLOAD_ROOT_PATH=./uploads

# --- Email (Gmail SMTP: use an app password) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Stripe (test mode keys) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Google (server-side Directions / travel time) ---
GOOGLE_MAPS_API_KEY=
