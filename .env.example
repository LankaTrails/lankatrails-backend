# Copy to .env (git-ignored). Read by docker-compose.dev.yml (for the containers) and by
# Spring Boot inside the backend container. Hostnames are the compose service names.

# --- PostgreSQL + PostGIS ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=lankatrails
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- MongoDB (chat history) ---
MONGODB_URI=mongodb://mongodb:27017/lankatrails

# --- Redis (refresh tokens, cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=lankatrails
REDIS_SSL_ENABLED=false

# --- RabbitMQ (AMQP + STOMP broker relay) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_STOMP_PORT=61613
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_USERNAME=lankatrails
RABBITMQ_PASSWORD=lankatrails

# --- Ports published on your machine (change only if they clash with something local) ---
API_PORT=8080
POSTGRES_HOST_PORT=5432
MONGODB_HOST_PORT=27017
REDIS_HOST_PORT=6379

# --- Security ---
# Base64-encoded key of at least 256 bits, e.g. `openssl rand -base64 64`
JWT_SECRET=
# Access token lifetime (1 hour) and refresh token lifetime (7 days), in milliseconds
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
# Public base URL of this API, used in email verification links
APP_PUBLIC_API_URL=http://localhost:8080
# Initial admin account, created on first start if no admin exists. Use a strong password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Password given to the seeded demo provider/tourist accounts (docker/seed/load-seed.sh)
DEMO_USER_PASSWORD=
# Login throttling (fixed 60 s window): attempts per client IP + account, and per client IP.
# In Docker every host request shares the gateway IP, so the per-IP limit covers all local users.
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
LOGIN_RATE_LIMIT_PER_IP=30
# Set to "native" behind a reverse proxy that sends X-Forwarded-For
FORWARD_HEADERS_STRATEGY=none
# Comma-separated browser origins for REST CORS and the /ws endpoint
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:19006

# --- File uploads (inside the container; ./uploads on your machine) ---
UPLOAD_ROOT_PATH=/app/uploads

# --- Email (Gmail SMTP: use an app password) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Stripe (test mode keys) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=lkr
STRIPE_COMMISSION_RATE=0.10
# Country for providers' Stripe Connect Express accounts
STRIPE_CONNECT_COUNTRY=US
# Where Stripe sends providers back after onboarding
APP_PROVIDER_DASHBOARD_URL=http://localhost:5174

# --- Google (server-side Directions / travel time) ---
GOOGLE_MAPS_API_KEY=
